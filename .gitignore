# File: .gitignore
# Intent: Keeps local environments, caches, generated outputs, and machine-specific config out of git.
# Usage: Used automatically by git status/add/commit.
# Presets: Python caches, virtualenvs, outputs, timing dumps, local speed config, editor files.
# Connects: config/robot_speeds.txt; outputs/; .venv/; PyBullet timings_*.json.
# User values: ignore patterns added when new generated/local files appear.
#
# Functions:
# - None: Git ignore rules file.

# Virtual environments
.venv/
venv/
env/

# Python cache/build output
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/

# Test/tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
timings_*.json
outputs/
!outputs/
outputs/*
!outputs/testing/
!outputs/testing/**

# Local config
.env
.env.*
!.env.example
config/robot_speeds.txt

# Editors/OS
.vscode/
!.vscode/
!.vscode/launch.json
.idea/
.DS_Store
Thumbs.db
docs/2026-06-02 23-19-30.mp4
